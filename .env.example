# Backend
COLA_HOST=127.0.0.1
COLA_PORT=8000
COLA_SIMULATION_DELAY_MS=120
COLA_OLLAMA_URL=http://127.0.0.1:11434
COLA_OLLAMA_MODEL=qwen3.5:9b
# Auto: OpenRouter free when configured, otherwise Ollama
COLA_LLM_PROVIDER=auto
# Paid APIs are blocked unless explicitly changed to false
COLA_FREE_ONLY=true
OPENROUTER_API_KEY=
COLA_OPENROUTER_MODEL=xingchen-agi/xing4.0-29b-a4b:free
COLA_OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3.5-super-vl:free
# Optional custom path to the imported interview database
# COLA_QUESTION_DB=C:/path/to/interview.sqlite
# Put the real key only in .env (gitignored); never commit it
OPENAI_API_KEY=
COLA_OPENAI_MODEL=gpt-4o-mini
COLA_OPENAI_TEMPERATURE=0.4
COLA_AUDIO_CHUNK_FRAMES=1024
COLA_WHISPER_MODEL=small
COLA_TRANSCRIPTION_LANGUAGE=pt

# Desktop
VITE_COLA_WS_URL=ws://127.0.0.1:8000/ws

